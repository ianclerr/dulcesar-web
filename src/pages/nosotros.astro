---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';

const timeline = [
  ['1982', 'Fundación de Dul-Cesar', 'En un pequeño hogar, bajo la sombra de un árbol de mango, nació una pasión impulsada por una visión clara: ofrecer productos alimenticios elaborados con dedicación, respeto por la tradición y un profundo compromiso.'],
  ['1985', 'Primeros productos', 'La mermelada de guayaba tradicional fue el primer producto en salir al mercado y conquistó los hogares paraguayos por su sabor auténtico y su calidad constante. Le siguieron el dulce de mamón y el dulce de batata tradicional.'],
  ['1990', 'Crecimiento familiar', 'Con el liderazgo de Aníbal Ramón Zimardi y Ana María Riveros de Zimardi, Dul-Cesar creció apostando a la mejora continua, la expansión del portafolio y procesos productivos eficientes y sostenibles.'],
  ['2000', 'Un portafolio más amplio', 'Mermeladas, dulces, aderezos, salsas, vinagres y más productos que buscan simplificar la vida del consumidor.'],
  ['2010', 'Más de 200 productos', 'Lo que comenzó como un pequeño emprendimiento hoy abastece puntos de venta con el objetivo de ganar el corazón de los consumidores.'],
  ['Hoy', 'Una identidad renovada', 'Nos proyectamos con un enfoque estratégico orientado a mercados más exigentes, sin perder nuestra esencia familiar ni nuestra raíz profundamente paraguaya.'],
];

const commitments = [
  ['Seguridad alimentaria', 'Los más altos estándares de calidad y seguridad en cada etapa del proceso.'],
  ['Tradición y tecnología', 'Un modelo de gestión que combina recetas de origen con procesos eficientes y sostenibles.'],
  ['Proveedores locales', 'Impulsamos el desarrollo de proveedores paraguayos.'],
  ['Vínculos con clientes', 'Fortalecemos la relación con nuestros clientes a nivel nacional e internacional.'],
];
---

<BaseLayout
  title="Nosotros | Dul-Cesar"
  description="Conocé la historia de Dul-Cesar, una empresa familiar paraguaya que elabora alimentos desde 1982."
  image="/images/picnic.webp"
>
  <PageHero
    eyebrow="Nuestra historia"
    title="Raíces familiares, sabor paraguayo"
    description="Tradición, calidad y compromiso con el sabor paraguayo."
    image="/images/picnic.webp"
  />

  <section class="section pattern">
    <div class="container-site grid items-center gap-10 lg:grid-cols-2">
      <div class="reveal">
        <span class="font-extrabold uppercase tracking-[.18em] text-red-700">Nuestros orígenes</span>
        <h2 class="section-title mt-3">Una idea nacida en familia</h2>
        <p class="mt-6 text-lg leading-relaxed text-neutral-600">
          Dul-Cesar ICSA es una empresa paraguaya con más de 40 años de trayectoria, dedicada a la
          producción, fraccionamiento, envasado, distribución e importación de productos alimenticios,
          comprometida con los más altos estándares de calidad y seguridad en cada etapa del proceso.
        </p>
        <p class="mt-4 text-lg leading-relaxed text-neutral-600">
          Así surgió Dul-Cesar, una marca que con el paso del tiempo se consolidó como referente en la
          industria nacional de alimentos.
        </p>
      </div>
      <div class="card reveal p-8 sm:p-10">
        <p class="font-display text-4xl text-red-700">Nuestro propósito</p>
        <blockquote class="mt-5 text-xl leading-relaxed text-neutral-700">
          “Acompañar los momentos cotidianos de las familias, con equilibrio entre innovación, sabor y
          respeto por los valores que nos dieron origen.”
        </blockquote>
        <div class="mt-8 grid grid-cols-2 gap-4">
          <div class="rounded-2xl bg-red-50 p-5">
            <strong class="font-display text-4xl text-red-700">40+</strong>
            <span class="block text-sm font-bold">años de historia</span>
          </div>
          <div class="rounded-2xl bg-orange-50 p-5">
            <strong class="font-display text-4xl text-orange-700">200+</strong>
            <span class="block text-sm font-bold">productos desarrollados</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section bg-white">
    <div class="container-site">
      <div class="mx-auto mb-12 max-w-3xl text-center reveal">
        <span class="font-extrabold uppercase tracking-[.18em] text-red-700">Nuestra trayectoria</span>
        <h2 class="section-title mt-3">Cuatro décadas creciendo</h2>
      </div>
      <ol class="relative mx-auto max-w-4xl border-l-2 border-red-200 pl-8 sm:pl-12">
        {
          timeline.map(([year, title, text]) => (
            <li class="reveal relative pb-10 last:pb-0">
              <span class="absolute -left-[2.65rem] top-1 h-5 w-5 rounded-full border-4 border-white bg-red-700 sm:-left-[3.65rem]"></span>
              <p class="text-sm font-black uppercase tracking-widest text-red-700">{year}</p>
              <h3 class="mt-1 font-display text-3xl">{title}</h3>
              <p class="mt-2 leading-relaxed text-neutral-600">{text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section pattern">
    <div class="container-site">
      <div class="mx-auto mb-12 max-w-3xl text-center reveal">
        <span class="font-extrabold uppercase tracking-[.18em] text-red-700">Cómo trabajamos</span>
        <h2 class="section-title mt-3">Compromiso en cada etapa</h2>
      </div>
      <div class="grid gap-6 sm:grid-cols-2">
        {
          commitments.map(([title, text], index) => (
            <article class="card reveal flex gap-5 p-7">
              <span class="grid h-12 w-12 shrink-0 place-items-center rounded-xl bg-red-700 font-black text-white">
                {String(index + 1).padStart(2, '0')}
              </span>
              <div>
                <h3 class="text-xl font-black">{title}</h3>
                <p class="mt-2 text-neutral-600">{text}</p>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section bg-red-800 text-center text-white">
    <div class="container-site reveal">
      <h2 class="section-title">El futuro conserva nuestra esencia</h2>
      <p class="mx-auto mt-6 max-w-3xl text-lg text-white/80">
        Porque en cada frasco, en cada envase y en cada sabor, seguimos transmitiendo lo que nos mueve
        desde el primer día: el deseo de llevar a la mesa de cada hogar #Dulcesmomentos.
      </p>
      <a href="/contacto" class="btn btn-light mt-8">Ponete en contacto</a>
    </div>
  </section>
</BaseLayout>
