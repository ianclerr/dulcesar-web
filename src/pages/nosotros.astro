---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';

const timeline = [
  ['1982', 'Fundación de Dul-Cesar', 'Nacimos en un pequeño hogar, bajo la sombra de un árbol de mango, con el deseo de elaborar alimentos con dedicación y respeto por la tradición.'],
  ['1985', 'Primeros productos', 'La mermelada de guayaba conquistó hogares paraguayos, seguida por el dulce de mamón y el dulce de batata.'],
  ['1990', 'Crecimiento familiar', 'Con el liderazgo de Aníbal Ramón Zimardi y Ana María Riveros de Zimardi, la empresa apostó por la mejora continua.'],
  ['2000', 'Un portafolio más amplio', 'Sumamos mermeladas, dulces, aderezos, salsas, vinagres y nuevas líneas de alimentos.'],
  ['2010', 'Más de 200 productos', 'Ampliamos nuestra presencia para abastecer puntos de venta en todo Paraguay.'],
  ['Hoy', 'Una identidad renovada', 'Seguimos proyectándonos hacia mercados exigentes sin perder la esencia familiar ni nuestra raíz paraguaya.'],
];

const commitments = [
  ['Selección de ingredientes', 'Trabajamos con materias primas seleccionadas para cuidar el sabor y la calidad.'],
  ['Procesos responsables', 'Combinamos técnicas tradicionales y tecnología para lograr productos consistentes.'],
  ['Control de calidad', 'Cada etapa, desde la recepción de insumos hasta el producto final, recibe seguimiento.'],
  ['Innovación continua', 'Desarrollamos nuevas opciones atendiendo las necesidades de las familias y del mercado.'],
];
---

<BaseLayout
  title="Nosotros | Dul-Cesar"
  description="Conocé la historia de Dul-Cesar, una empresa familiar paraguaya que elabora alimentos desde 1982."
  image="/images/picnic.webp"
>
  <PageHero
    eyebrow="Nuestra historia"
    title="Raíces familiares, sabor paraguayo"
    description="Una historia de trabajo, cercanía e innovación que comenzó en 1982 y sigue creciendo con cada producto."
    image="/images/picnic.webp"
  />

  <section class="section pattern">
    <div class="container-site grid items-center gap-10 lg:grid-cols-2">
      <div class="reveal">
        <span class="font-extrabold uppercase tracking-[.18em] text-red-700">Nuestros orígenes</span>
        <h2 class="section-title mt-3">Una idea nacida en familia</h2>
        <p class="mt-6 text-lg leading-relaxed text-neutral-600">
          Dul-Cesar comenzó como un emprendimiento familiar. Desde el inicio, la misión fue sencilla:
          acercar productos ricos, confiables y elaborados con el cuidado de una receta hecha en casa.
        </p>
        <p class="mt-4 text-lg leading-relaxed text-neutral-600">
          Aníbal Ramón Zimardi y Ana María Riveros de Zimardi guiaron ese crecimiento con una mirada
          puesta en la calidad, el trabajo constante y el respeto por quienes eligen nuestros sabores.
        </p>
      </div>
      <div class="card reveal p-8 sm:p-10">
        <p class="font-display text-4xl text-red-700">Nuestro propósito</p>
        <blockquote class="mt-5 text-xl leading-relaxed text-neutral-700">
          “Crear productos que acompañen la vida cotidiana y mantengan vivo el sabor de compartir.”
        </blockquote>
        <div class="mt-8 grid grid-cols-2 gap-4">
          <div class="rounded-2xl bg-red-50 p-5">
            <strong class="font-display text-4xl text-red-700">40+</strong>
            <span class="block text-sm font-bold">años de historia</span>
          </div>
          <div class="rounded-2xl bg-orange-50 p-5">
            <strong class="font-display text-4xl text-orange-700">200+</strong>
            <span class="block text-sm font-bold">productos desarrollados</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section bg-white">
    <div class="container-site">
      <div class="mx-auto mb-12 max-w-3xl text-center reveal">
        <span class="font-extrabold uppercase tracking-[.18em] text-red-700">Nuestra trayectoria</span>
        <h2 class="section-title mt-3">Cuatro décadas creciendo</h2>
      </div>
      <ol class="relative mx-auto max-w-4xl border-l-2 border-red-200 pl-8 sm:pl-12">
        {
          timeline.map(([year, title, text]) => (
            <li class="reveal relative pb-10 last:pb-0">
              <span class="absolute -left-[2.65rem] top-1 h-5 w-5 rounded-full border-4 border-white bg-red-700 sm:-left-[3.65rem]"></span>
              <p class="text-sm font-black uppercase tracking-widest text-red-700">{year}</p>
              <h3 class="mt-1 font-display text-3xl">{title}</h3>
              <p class="mt-2 leading-relaxed text-neutral-600">{text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section pattern">
    <div class="container-site">
      <div class="mx-auto mb-12 max-w-3xl text-center reveal">
        <span class="font-extrabold uppercase tracking-[.18em] text-red-700">Cómo trabajamos</span>
        <h2 class="section-title mt-3">Compromiso en cada etapa</h2>
      </div>
      <div class="grid gap-6 sm:grid-cols-2">
        {
          commitments.map(([title, text], index) => (
            <article class="card reveal flex gap-5 p-7">
              <span class="grid h-12 w-12 shrink-0 place-items-center rounded-xl bg-red-700 font-black text-white">
                {String(index + 1).padStart(2, '0')}
              </span>
              <div>
                <h3 class="text-xl font-black">{title}</h3>
                <p class="mt-2 text-neutral-600">{text}</p>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section bg-red-800 text-center text-white">
    <div class="container-site reveal">
      <h2 class="section-title">El futuro conserva nuestra esencia</h2>
      <p class="mx-auto mt-6 max-w-3xl text-lg text-white/80">
        Queremos llegar a más hogares y mercados con productos renovados, sin perder la cercanía, la
        dedicación y la identidad profundamente paraguaya que nos trajo hasta acá.
      </p>
      <a href="/contacto" class="btn btn-light mt-8">Ponete en contacto</a>
    </div>
  </section>
</BaseLayout>
