---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProductCatalog from '../components/ProductCatalog.astro';

const stats = [
  { value: '1982', label: 'Desde' },
  { value: '40+', label: 'Años' },
  { value: '200+', label: 'Productos' },
];

const values = [
  {
    title: 'Tradición',
    text: 'Recetas nacidas en familia y perfeccionadas durante más de cuatro décadas.',
    icon: '1982',
  },
  {
    title: 'Calidad',
    text: 'Altos estándares de calidad y seguridad alimentaria en cada etapa del proceso.',
    icon: '✓',
  },
  {
    title: 'Identidad',
    text: 'Sabores cercanos, pensados para las mesas y costumbres de Paraguay.',
    icon: 'PY',
  },
];

const recipes = [
  { title: 'Brownies clásicos', image: '/images/brownies.webp', text: 'Húmedos, intensos y perfectos para compartir.' },
  { title: 'Galletas de avena', image: '/images/galletadeavena.webp', text: 'Una receta sencilla para cualquier merienda.' },
  { title: 'Muffins de chocolate', image: '/images/muffins.webp', text: 'Esponjosos y llenos de sabor.' },
];

const mapsUrl = 'https://www.google.com/maps/search/?api=1&query=Productos+Dul-Cesar+San+Lorenzo+Paraguay';
---

<BaseLayout
  title="Dul-Cesar | Sabores con tradición paraguaya"
  description="Desde 1982 elaboramos mermeladas, aderezos, jugos y productos para compartir en familia."
>
  <section class="relative isolate overflow-hidden bg-red-800 text-white">
    <img
      src="/images/banner-principal.webp"
      alt=""
      fetchpriority="high"
      class="absolute inset-0 -z-20 h-full w-full object-cover object-[62%_center]"
    />
    <div class="absolute inset-0 -z-10 bg-gradient-to-b from-[#560d12]/95 via-red-800/82 to-[#7a1218]/90 lg:bg-gradient-to-r lg:from-[#560d12]/95 lg:via-red-800/78 lg:to-orange-600/30"></div>

    <div class="container-site relative grid items-end gap-5 pb-14 pt-8 sm:gap-8 sm:pb-20 sm:pt-12 lg:min-h-[38rem] lg:grid-cols-[1.2fr_.8fr] lg:gap-8 lg:pb-24 lg:pt-16">
      <div class="reveal relative z-10 max-w-2xl">
        <span class="eyebrow">Desde 1982 · Industria paraguaya</span>
        <h1 class="mt-4 max-w-[12ch] font-display text-[2.55rem] leading-[0.98] sm:text-6xl lg:text-8xl lg:leading-[.95]">
          El sabor de compartir
        </h1>
        <p class="mt-4 max-w-lg text-[0.98rem] leading-relaxed text-white/85 sm:mt-5 sm:text-xl">
          Tradición, calidad y compromiso con el sabor paraguayo. Más de 40 años acompañando
          momentos cotidianos.
        </p>
        <div class="mt-7 grid grid-cols-2 gap-3 sm:flex sm:flex-wrap">
          <a class="btn btn-light col-span-2 sm:col-auto" href="#productos">Conocer productos</a>
          <a class="btn col-span-2 border border-white/35 bg-white/10 text-white hover:bg-white/20 sm:col-auto" href="/nosotros">
            Nuestra historia
          </a>
        </div>
      </div>

      <div class="relative -mb-8 flex justify-center sm:-mb-10 lg:mb-0 lg:justify-end lg:self-end">
        <div class="absolute bottom-4 h-14 w-44 rounded-[50%] bg-black/30 blur-2xl lg:bottom-10 lg:h-24 lg:w-72"></div>
        <img
          src="/images/imagenes/cesarito-1.webp"
          alt="Cesarito, personaje de Dul-Cesar"
          width="520"
          height="760"
          class="relative max-h-[15.5rem] w-auto drop-shadow-2xl sm:max-h-72 lg:max-h-[33rem]"
        />
      </div>
    </div>
  </section>

  <div class="relative z-10 -mt-10 px-4 sm:-mt-12">
    <dl class="card mx-auto grid max-w-5xl grid-cols-3 divide-x divide-red-100 py-4 text-center sm:py-6">
      {
        stats.map((stat) => (
          <div class="px-1.5 sm:px-4">
            <dt class="text-[0.7rem] font-bold uppercase tracking-wide text-neutral-500 sm:text-sm sm:normal-case sm:tracking-normal">
              {stat.label}
            </dt>
            <dd class="font-display text-[1.85rem] leading-none text-red-700 sm:mt-1 sm:text-5xl">{stat.value}</dd>
          </div>
        ))
      }
    </dl>
  </div>

  <ProductCatalog />

  <section class="section pattern">
    <div class="container-site grid items-center gap-8 lg:grid-cols-2 lg:gap-16">
      <div class="reveal">
        <span class="kicker">Nuestra esencia</span>
        <h2 class="section-title mt-3">Más de 40 años endulzando momentos</h2>
        <p class="mt-4 text-neutral-600 sm:mt-5 sm:text-lg sm:leading-relaxed">
          Dul-Cesar nació en 1982 bajo la sombra de un árbol de mango. Hoy combinamos tradición y
          tecnología para llevar productos seguros y llenos de sabor a hogares de todo Paraguay.
        </p>
        <ul class="mt-6 grid gap-3 sm:mt-8">
          {
            values.map((value) => (
              <li class="card flex items-start gap-4 p-4 sm:p-5">
                <span class="grid h-11 w-11 shrink-0 place-items-center rounded-2xl bg-red-50 text-sm font-black text-red-700 sm:h-12 sm:w-12">
                  {value.icon}
                </span>
                <div>
                  <h3 class="text-base font-black sm:text-lg">{value.title}</h3>
                  <p class="mt-1 text-sm text-neutral-600 sm:text-base">{value.text}</p>
                </div>
              </li>
            ))
          }
        </ul>
        <a class="btn btn-primary mt-7 w-full sm:mt-8 sm:w-auto" href="/nosotros">Conocé nuestra historia</a>
      </div>
      <div class="relative reveal">
        <img
          src="/images/picnic.webp"
          alt="Productos Dul-Cesar para compartir"
          width="1065"
          height="1600"
          loading="lazy"
          class="aspect-[4/3] w-full rounded-[1.5rem] object-cover shadow-2xl sm:rounded-[2rem] lg:aspect-[4/5]"
        />
        <div class="absolute bottom-3 left-3 rounded-2xl bg-red-700 px-4 py-3 text-white shadow-xl sm:bottom-6 sm:left-6 sm:px-5 sm:py-4">
          <strong class="block font-display text-2xl sm:text-3xl">Hecho en Paraguay</strong>
          <span class="text-xs text-white/85 sm:text-sm">San Lorenzo, desde 1982</span>
        </div>
      </div>
    </div>
  </section>

  <section class="section bg-white">
    <div class="container-site">
      <div class="mb-6 flex flex-col justify-between gap-4 sm:mb-10 sm:flex-row sm:items-end">
        <div class="reveal">
          <span class="kicker">Ideas para disfrutar</span>
          <h2 class="section-title mt-3">Recetas Dul-Cesar</h2>
        </div>
        <a class="btn btn-primary hidden w-fit sm:inline-flex" href="/recetario">Ver el recetario</a>
      </div>
      <div class="no-scrollbar -mx-4 flex snap-x snap-mandatory scroll-px-4 gap-4 overflow-x-auto px-4 pb-2 md:mx-0 md:grid md:grid-cols-3 md:gap-6 md:overflow-visible md:px-0">
        {
          recipes.map((recipe) => (
            <a
              href="/recetario"
              class="card group w-[82%] shrink-0 snap-start overflow-hidden transition hover:-translate-y-1 sm:w-[55%] md:w-auto"
            >
              <img
                src={recipe.image}
                alt={recipe.title}
                width="700"
                height="500"
                loading="lazy"
                class="aspect-[4/3] w-full object-cover transition duration-500 group-hover:scale-105"
              />
              <div class="p-5 sm:p-6">
                <h3 class="font-display text-2xl sm:text-3xl">{recipe.title}</h3>
                <p class="mt-2 text-neutral-600">{recipe.text}</p>
              </div>
            </a>
          ))
        }
      </div>
      <a class="btn btn-primary mt-6 w-full sm:hidden" href="/recetario">Ver el recetario</a>
    </div>
  </section>

  <section class="section bg-red-800 text-white">
    <div class="container-site grid gap-7 lg:grid-cols-[.85fr_1.15fr] lg:items-center lg:gap-10">
      <div class="reveal">
        <span class="eyebrow">San Lorenzo · Paraguay</span>
        <h2 class="section-title mt-4">Encontranos cerca</h2>
        <p class="mt-4 max-w-xl text-white/80 sm:mt-5 sm:text-lg">
          Celsa Speratti y De la Honestidad 1372. Lunes a viernes, de 07:00 a 17:00.
        </p>
        <div class="mt-6 grid grid-cols-2 gap-3 sm:mt-7 sm:flex sm:flex-wrap">
          <a class="btn btn-light col-span-2" href="tel:+59521575776">Llamar</a>
          <a class="btn border border-white/35 bg-white/10 text-white hover:bg-white/20" href={mapsUrl} target="_blank" rel="noopener">
            Cómo llegar
          </a>
          <a
            class="btn border border-white/35 bg-white/10 text-white hover:bg-white/20"
            href="https://www.instagram.com/productos_dulcesar/"
            target="_blank"
            rel="noopener"
          >
            Instagram
          </a>
        </div>
      </div>
      <iframe
        title="Ubicación de Dul-Cesar en Google Maps"
        src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3605.4247538301897!2d-57.525793925651655!3d-25.35707723000846!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x945dae851a06563d%3A0x46de4aeebb30b2ce!2sProductos%20Dul-Cesar!5e0!3m2!1ses!2spy!4v1750490688084!5m2!1ses!2spy"
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
        class="h-64 w-full rounded-[1.5rem] bg-white shadow-2xl sm:h-[420px] sm:rounded-[2rem]"
      ></iframe>
    </div>
  </section>
</BaseLayout>
