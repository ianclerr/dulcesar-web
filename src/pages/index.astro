---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProductCatalog from '../components/ProductCatalog.astro';

const values = [
  {
    title: 'Tradición',
    text: 'Recetas nacidas en familia y perfeccionadas durante más de cuatro décadas.',
    icon: '1982',
  },
  {
    title: 'Calidad',
    text: 'Ingredientes seleccionados y controles que acompañan cada etapa de elaboración.',
    icon: '✓',
  },
  {
    title: 'Identidad',
    text: 'Sabores cercanos, pensados para las mesas y costumbres de Paraguay.',
    icon: 'PY',
  },
];
---

<BaseLayout
  title="Dul-Cesar | Sabores con tradición paraguaya"
  description="Desde 1982 elaboramos mermeladas, aderezos, jugos y productos para compartir en familia."
>
  <section class="relative isolate overflow-hidden bg-red-800 text-white">
    <img
      src="/images/banner-principal.webp"
      alt=""
      fetchpriority="high"
      class="absolute inset-0 -z-20 h-full w-full object-cover"
    />
    <div class="absolute inset-0 -z-10 bg-gradient-to-r from-[#560d12]/95 via-red-800/80 to-orange-600/35"></div>
    <div class="container-site grid min-h-[42rem] items-center gap-10 py-16 lg:grid-cols-[1.15fr_.85fr]">
      <div class="reveal">
        <span class="eyebrow">Desde 1982 · Industria paraguaya</span>
        <h1 class="mt-6 max-w-3xl font-display text-6xl leading-[.95] sm:text-7xl lg:text-8xl">
          El sabor de compartir
        </h1>
        <p class="mt-6 max-w-2xl text-lg leading-relaxed text-white/85 sm:text-xl">
          Más de 40 años acompañando momentos cotidianos con mermeladas, jugos, aderezos y
          productos elaborados con dedicación.
        </p>
        <div class="mt-9 flex flex-wrap gap-3">
          <a class="btn btn-light" href="#productos">Conocer productos</a>
          <a class="btn border border-white/35 bg-white/10 text-white hover:bg-white/20" href="/nosotros">
            Nuestra historia
          </a>
        </div>
      </div>
      <div class="relative flex self-end justify-center lg:justify-end">
        <div class="absolute bottom-8 h-24 w-72 rounded-[50%] bg-black/25 blur-2xl"></div>
        <img
          src="/images/imagenes/cesarito-1.webp"
          alt="Cesarito, personaje de Dul-Cesar"
          width="520"
          height="680"
          class="relative max-h-[35rem] w-auto drop-shadow-2xl"
        />
      </div>
    </div>
  </section>

  <section class="section pattern">
    <div class="container-site">
      <div class="mx-auto max-w-4xl text-center reveal">
        <span class="font-extrabold uppercase tracking-[.18em] text-red-700">Nuestra esencia</span>
        <h2 class="section-title mt-3">Más de 40 años endulzando momentos</h2>
        <p class="mt-6 text-lg leading-relaxed text-neutral-600 sm:text-xl">
          Dul-Cesar nació bajo la sombra de un árbol de mango. Hoy seguimos creciendo con la misma
          cercanía familiar y el compromiso de llevar calidad a hogares de todo Paraguay.
        </p>
      </div>
      <div class="mt-12 grid gap-6 md:grid-cols-3">
        {
          values.map((value) => (
            <article class="card reveal p-7 text-center">
              <span class="mx-auto grid h-16 w-16 place-items-center rounded-2xl bg-red-50 font-black text-red-700">
                {value.icon}
              </span>
              <h3 class="mt-5 font-display text-3xl">{value.title}</h3>
              <p class="mt-3 text-neutral-600">{value.text}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section bg-white">
    <div class="container-site grid items-center gap-10 lg:grid-cols-2">
      <div class="relative reveal">
        <img
          src="/images/picnic.webp"
          alt="Productos Dul-Cesar para compartir"
          width="1000"
          height="760"
          loading="lazy"
          class="h-[31rem] w-full rounded-[2rem] object-cover shadow-2xl"
        />
        <div class="absolute -bottom-5 -right-3 rounded-2xl bg-red-700 px-6 py-5 text-white shadow-xl sm:right-8">
          <strong class="block font-display text-3xl">200+</strong>
          <span class="text-sm">productos desarrollados</span>
        </div>
      </div>
      <div class="reveal">
        <span class="font-extrabold uppercase tracking-[.18em] text-red-700">Hecho en Paraguay</span>
        <h2 class="section-title mt-3">Tradición que evoluciona</h2>
        <p class="mt-6 text-lg leading-relaxed text-neutral-600">
          Combinamos procesos artesanales con tecnología moderna para ofrecer productos consistentes,
          seguros y llenos de sabor.
        </p>
        <ul class="mt-7 grid gap-3 text-neutral-700 sm:grid-cols-2">
          <li class="rounded-xl bg-red-50 p-4 font-bold">Ingredientes seleccionados</li>
          <li class="rounded-xl bg-orange-50 p-4 font-bold">Control de calidad</li>
          <li class="rounded-xl bg-orange-50 p-4 font-bold">Innovación continua</li>
          <li class="rounded-xl bg-red-50 p-4 font-bold">Presencia nacional</li>
        </ul>
        <a class="btn btn-primary mt-8" href="/nosotros">Conocé más sobre nosotros</a>
      </div>
    </div>
  </section>

  <ProductCatalog />

  <section class="section pattern">
    <div class="container-site">
      <div class="mb-10 flex flex-col justify-between gap-5 sm:flex-row sm:items-end">
        <div class="reveal">
          <span class="font-extrabold uppercase tracking-[.18em] text-red-700">Ideas para disfrutar</span>
          <h2 class="section-title mt-3">Recetas Dul-Cesar</h2>
        </div>
        <a class="btn btn-primary w-fit" href="/recetario">Ver el recetario</a>
      </div>
      <div class="grid gap-6 md:grid-cols-3">
        {
          [
            ['Brownies clásicos', '/images/brownies.webp', 'Húmedos, intensos y perfectos para compartir.'],
            ['Galletas de avena', '/images/galletadeavena.webp', 'Una receta sencilla para cualquier merienda.'],
            ['Muffins de chocolate', '/images/muffins.webp', 'Esponjosos y llenos de sabor.'],
          ].map(([title, image, text]) => (
            <article class="card reveal overflow-hidden">
              <img src={image} alt={title} width="700" height="500" loading="lazy" class="h-56 w-full object-cover" />
              <div class="p-6">
                <h3 class="font-display text-3xl">{title}</h3>
                <p class="mt-2 text-neutral-600">{text}</p>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section bg-red-800 text-white">
    <div class="container-site grid gap-10 lg:grid-cols-[.85fr_1.15fr] lg:items-center">
      <div class="reveal">
        <span class="eyebrow">San Lorenzo · Paraguay</span>
        <h2 class="section-title mt-4">Encontranos cerca</h2>
        <p class="mt-5 max-w-xl text-lg text-white/80">
          Nuestra planta principal está en Celsa Speratti y De la Honestidad 1372. Te esperamos de
          lunes a viernes, de 07:00 a 17:00.
        </p>
        <a class="btn btn-light mt-7" href="/contacto">Información de contacto</a>
      </div>
      <iframe
        title="Ubicación de Dul-Cesar en Google Maps"
        src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3605.4247538301897!2d-57.525793925651655!3d-25.35707723000846!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x945dae851a06563d%3A0x46de4aeebb30b2ce!2sProductos%20Dul-Cesar!5e0!3m2!1ses!2spy!4v1750490688084!5m2!1ses!2spy"
        width="100%"
        height="420"
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
        class="rounded-[2rem] bg-white shadow-2xl"
      ></iframe>
    </div>
  </section>
</BaseLayout>
