---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Página no encontrada | Dul-Cesar"
  description="La página que buscás no está disponible."
>
  <section class="pattern grid min-h-[70vh] place-items-center px-4 py-16 text-center">
    <div class="max-w-lg">
      <p class="font-display text-7xl text-red-700 sm:text-8xl">404</p>
      <h1 class="mt-4 font-display text-3xl sm:text-4xl">Esta página no está disponible</h1>
      <p class="mt-3 text-neutral-600">Puede que la dirección haya cambiado durante la renovación del sitio.</p>
      <a class="btn btn-primary mt-7 w-full sm:w-auto" href="/">Volver al inicio</a>
    </div>
  </section>
</BaseLayout>
