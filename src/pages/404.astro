---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Página no encontrada | Dul-Cesar"
  description="La página que buscás no está disponible."
>
  <section class="pattern grid min-h-[65vh] place-items-center px-4 py-20 text-center">
    <div>
      <p class="font-display text-8xl text-red-700">404</p>
      <h1 class="mt-4 text-3xl font-black">Esta página no está disponible</h1>
      <p class="mt-3 text-neutral-600">Puede que la dirección haya cambiado durante la renovación del sitio.</p>
      <a class="btn btn-primary mt-7" href="/">Volver al inicio</a>
    </div>
  </section>
</BaseLayout>
