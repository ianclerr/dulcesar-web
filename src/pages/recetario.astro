---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';

const recipes = [
  {
    title: 'Brownies clásicos',
    image: '/images/brownies.webp',
    description: 'Húmedos, intensos y con una cubierta delicadamente crocante.',
    time: '40 min',
  },
  {
    title: 'Galletas de avena',
    image: '/images/galletadeavena.webp',
    description: 'Crujientes, simples y perfectas para acompañar el café.',
    time: '30 min',
  },
  {
    title: 'Muffins de chocolate',
    image: '/images/muffins.webp',
    description: 'Esponjosos y prácticos para una merienda compartida.',
    time: '35 min',
  },
];
---

<BaseLayout
  title="Recetario | Dul-Cesar"
  description="Ideas dulces y recetas sencillas para disfrutar productos Dul-Cesar en familia."
  image="/images/recetario-banner.webp"
>
  <PageHero
    eyebrow="Ideas para compartir"
    title="Recetario Dul-Cesar"
    description="Recetas sencillas, consejos útiles y mucho sabor para transformar cada producto en un momento especial."
    image="/images/recetario-banner.webp"
  />

  <section class="section pattern">
    <div class="container-site">
      <article class="card mx-auto grid max-w-6xl overflow-hidden lg:grid-cols-2">
        <img
          src="/images/brownies.webp"
          alt="Brownies clásicos"
          width="900"
          height="900"
          class="h-full min-h-[28rem] w-full object-cover"
        />
        <div class="p-7 sm:p-10">
          <span class="font-black uppercase tracking-[.18em] text-red-700">Receta destacada</span>
          <h1 class="mt-3 font-display text-5xl">Brownies clásicos</h1>
          <p class="mt-4 text-neutral-600">
            Una receta intensa y fácil para acompañar meriendas, celebraciones o ese antojo de algo dulce.
          </p>

          <h2 class="mt-8 text-xl font-black">Ingredientes</h2>
          <ul class="mt-3 grid gap-2 text-neutral-700 sm:grid-cols-2">
            <li>200 g de harina</li>
            <li>150 g de azúcar</li>
            <li>80 g de cacao</li>
            <li>3 huevos</li>
            <li>120 g de manteca</li>
            <li>1 cucharadita de vainilla</li>
          </ul>

          <h2 class="mt-8 text-xl font-black">Preparación</h2>
          <ol class="mt-3 grid gap-3 text-neutral-700">
            <li><strong class="text-red-700">1.</strong> Precalentá el horno a 180 °C y prepará un molde.</li>
            <li><strong class="text-red-700">2.</strong> Mezclá harina, cacao y azúcar en un recipiente.</li>
            <li><strong class="text-red-700">3.</strong> Incorporá huevos, manteca derretida y vainilla.</li>
            <li><strong class="text-red-700">4.</strong> Horneá de 25 a 30 minutos y dejá enfriar antes de cortar.</li>
          </ol>
        </div>
      </article>
    </div>
  </section>

  <section class="section bg-white">
    <div class="container-site">
      <div class="mx-auto mb-12 max-w-3xl text-center reveal">
        <span class="font-extrabold uppercase tracking-[.18em] text-red-700">Más ideas</span>
        <h2 class="section-title mt-3">Recetas para guardar</h2>
      </div>
      <div class="grid gap-6 md:grid-cols-3">
        {
          recipes.map((recipe) => (
            <article class="card reveal overflow-hidden">
              <img
                src={recipe.image}
                alt={recipe.title}
                width="700"
                height="500"
                loading="lazy"
                class="h-60 w-full object-cover"
              />
              <div class="p-6">
                <div class="flex items-center justify-between gap-3">
                  <h3 class="font-display text-3xl">{recipe.title}</h3>
                  <span class="whitespace-nowrap rounded-full bg-red-50 px-3 py-1 text-xs font-black text-red-700">
                    {recipe.time}
                  </span>
                </div>
                <p class="mt-3 text-neutral-600">{recipe.description}</p>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section bg-red-50">
    <div class="container-site grid gap-6 md:grid-cols-3">
      <article class="card reveal p-7">
        <span class="text-3xl">♨</span>
        <h2 class="mt-4 text-xl font-black">Temperatura correcta</h2>
        <p class="mt-2 text-neutral-600">Precalentá siempre el horno para lograr una cocción pareja.</p>
      </article>
      <article class="card reveal p-7">
        <span class="text-3xl">⚖</span>
        <h2 class="mt-4 text-xl font-black">Medidas precisas</h2>
        <p class="mt-2 text-neutral-600">Pesá los ingredientes secos para obtener resultados consistentes.</p>
      </article>
      <article class="card reveal p-7">
        <span class="text-3xl">♡</span>
        <h2 class="mt-4 text-xl font-black">Tiempo de reposo</h2>
        <p class="mt-2 text-neutral-600">Dejá enfriar antes de cortar para conservar la textura.</p>
      </article>
    </div>
  </section>
</BaseLayout>
