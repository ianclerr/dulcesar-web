---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';

const recipes = [
  {
    id: 'brownies-clasicos',
    title: 'Brownies clásicos',
    image: '/images/brownies.webp',
    description: 'Brownies de cacao Dul-Cesar, húmedos por dentro y fáciles de preparar.',
    time: '30 min',
    product: 'Cacao Dul-Cesar',
    ingredients: [
      '200 g de Cacao Dul-Cesar',
      '150 g de Azúcar Dul-Cesar',
      '3 huevos',
      '200 g de harina',
    ],
    steps: [
      'Mezclá el cacao Dul-Cesar, la harina y el azúcar.',
      'Incorporá los huevos y los demás ingredientes líquidos.',
      'Llevá al horno a 180 °C durante 25 minutos.',
    ],
  },
  {
    id: 'galletas-de-avena',
    title: 'Galletas de avena',
    image: '/images/galletadeavena.webp',
    description: 'Galletas crujientes con avena y Azúcar Dul-Cesar para compartir en la merienda.',
    time: '30 min',
    product: 'Azúcar Dul-Cesar',
    ingredients: [
      '150 g de Azúcar Dul-Cesar',
      '200 g de avena',
      '150 g de harina',
      '100 g de mantequilla',
    ],
    steps: [
      'Mezclá la avena, la harina y el azúcar.',
      'Incorporá la mantequilla derretida hasta integrar.',
      'Formá las galletas y horneá a 180 °C durante 15 minutos.',
    ],
  },
];
---

<BaseLayout
  title="Recetario | Dul-Cesar"
  description="Ideas dulces y recetas sencillas para disfrutar productos Dul-Cesar en familia."
  image="/images/recetario-banner.webp"
>
  <PageHero
    eyebrow="Ideas para compartir"
    title="Recetario Dul-Cesar"
    description="Recetas sencillas, consejos útiles y mucho sabor para transformar cada producto en un momento especial."
    image="/images/recetario-banner.webp"
  />

  <section class="section pattern">
    <div class="container-site">
      <article class="card mx-auto grid max-w-6xl overflow-hidden lg:grid-cols-2">
        <img
          src="/images/brownies.webp"
          alt="Torta de chocolate premium"
          width="900"
          height="900"
          class="aspect-[4/3] h-full w-full object-cover lg:aspect-auto lg:min-h-[28rem]"
        />
        <div class="p-5 sm:p-10">
          <span class="kicker">Receta destacada</span>
          <h2 class="mt-3 font-display text-3xl sm:text-5xl">Torta de chocolate premium</h2>
          <p class="mt-4 text-neutral-600">
            Una torta suave y chocolatosa preparada con Cacao y Azúcar Dul-Cesar. Rinde 8 porciones
            y está lista en aproximadamente 45 minutos.
          </p>

          <h3 class="mt-7 text-lg font-black sm:mt-8 sm:text-xl">Ingredientes</h3>
          <ul class="mt-3 grid gap-2 text-neutral-700 sm:grid-cols-2">
            <li><strong class="text-red-700">200 g de Cacao Dul-Cesar</strong></li>
            <li><strong class="text-red-700">150 g de Azúcar Dul-Cesar</strong></li>
            <li>3 huevos</li>
            <li>200 g de harina</li>
            <li>100 g de mantequilla</li>
            <li>120 ml de leche</li>
          </ul>

          <h3 class="mt-7 text-lg font-black sm:mt-8 sm:text-xl">Preparación</h3>
          <ol class="mt-3 grid gap-3 text-sm text-neutral-700 sm:text-base">
            <li><strong class="text-red-700">1.</strong> Precalentá el horno a 180 °C y engrasá un molde redondo.</li>
            <li><strong class="text-red-700">2.</strong> Mezclá el cacao Dul-Cesar con la harina y el azúcar.</li>
            <li><strong class="text-red-700">3.</strong> Incorporá los huevos batidos y la mantequilla derretida.</li>
            <li><strong class="text-red-700">4.</strong> Agregá la leche gradualmente hasta obtener una masa homogénea.</li>
            <li><strong class="text-red-700">5.</strong> Horneá entre 35 y 40 minutos, hasta que al insertar un palillo salga limpio.</li>
          </ol>
        </div>
      </article>
    </div>
  </section>

  <section class="section bg-white">
    <div class="container-site">
      <div class="mx-auto mb-8 max-w-3xl text-center reveal sm:mb-12">
        <span class="kicker">Más ideas</span>
        <h2 class="section-title mt-3">Recetas para guardar</h2>
      </div>
      <div class="grid gap-5 lg:grid-cols-2 lg:gap-7">
        {
          recipes.map((recipe) => (
            <article id={recipe.id} class="card reveal overflow-hidden">
              <img
                src={recipe.image}
                alt={recipe.title}
                width="700"
                height="500"
                loading="lazy"
                class="aspect-[4/3] w-full object-cover"
              />
              <div class="p-5 sm:p-6">
                <div class="flex flex-wrap items-center justify-between gap-3">
                  <h3 class="font-display text-2xl sm:text-3xl">{recipe.title}</h3>
                  <span class="whitespace-nowrap rounded-full bg-red-50 px-3 py-1 text-xs font-black text-red-700">
                    {recipe.time}
                  </span>
                </div>
                <p class="mt-3 text-neutral-600">{recipe.description}</p>
                <p class="mt-4 text-sm font-black uppercase tracking-wider text-red-700">
                  Producto destacado: {recipe.product}
                </p>

                <details class="group mt-5 border-t border-red-100 pt-5 sm:mt-6">
                  <summary class="flex min-h-11 cursor-pointer list-none items-center justify-between font-black text-red-700">
                    Ver receta completa
                    <span class="text-xl transition group-open:rotate-45" aria-hidden="true">+</span>
                  </summary>
                  <div class="mt-5 grid gap-6 sm:grid-cols-2">
                    <div>
                      <h4 class="font-black">Ingredientes</h4>
                      <ul class="mt-3 grid gap-2 text-sm text-neutral-600">
                        {recipe.ingredients.map((ingredient) => <li>• {ingredient}</li>)}
                      </ul>
                    </div>
                    <div>
                      <h4 class="font-black">Preparación</h4>
                      <ol class="mt-3 grid gap-2 text-sm text-neutral-600">
                        {recipe.steps.map((step, index) => (
                          <li><strong class="text-red-700">{index + 1}.</strong> {step}</li>
                        ))}
                      </ol>
                    </div>
                  </div>
                </details>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section bg-red-50">
    <div class="container-site grid gap-4 sm:gap-6 md:grid-cols-3">
      <article class="card reveal p-5 sm:p-7">
        <span class="text-3xl">♨</span>
        <h2 class="mt-4 text-lg font-black sm:text-xl">Temperatura correcta</h2>
        <p class="mt-2 text-neutral-600">Precalentá siempre el horno para lograr una cocción pareja.</p>
      </article>
      <article class="card reveal p-5 sm:p-7">
        <span class="text-3xl">⚖</span>
        <h2 class="mt-4 text-lg font-black sm:text-xl">Medidas precisas</h2>
        <p class="mt-2 text-neutral-600">Pesá los ingredientes secos para obtener resultados consistentes.</p>
      </article>
      <article class="card reveal p-5 sm:p-7">
        <span class="text-3xl">♡</span>
        <h2 class="mt-4 text-lg font-black sm:text-xl">Tiempo de reposo</h2>
        <p class="mt-2 text-neutral-600">Dejá enfriar antes de cortar para conservar la textura.</p>
      </article>
    </div>
  </section>
</BaseLayout>
