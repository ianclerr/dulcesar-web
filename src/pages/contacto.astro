---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
---

<BaseLayout
  title="Contacto | Dul-Cesar"
  description="Contactá con Dul-Cesar. Encontrá nuestra dirección, horarios y canales de atención."
  image="/images/picnicontacto.webp"
>
  <PageHero
    eyebrow="Estamos para ayudarte"
    title="Hablemos"
    description="Consultas sobre productos, distribución o nuestra empresa. Elegí el canal que te resulte más cómodo."
    image="/images/picnicontacto.webp"
  />

  <section class="section pattern">
    <div class="container-site grid gap-7 md:grid-cols-3">
      <article class="card reveal p-7">
        <span class="text-3xl" aria-hidden="true">⌖</span>
        <h2 class="mt-4 font-display text-3xl">Dirección</h2>
        <p class="mt-3 text-neutral-600">
          Celsa Speratti y De la Honestidad 1372<br />San Lorenzo, Paraguay
        </p>
      </article>
      <article class="card reveal p-7">
        <span class="text-3xl" aria-hidden="true">◷</span>
        <h2 class="mt-4 font-display text-3xl">Horarios</h2>
        <p class="mt-3 text-neutral-600">
          Lunes a viernes<br />07:00 a 17:00
        </p>
      </article>
      <article class="card reveal p-7">
        <span class="text-3xl" aria-hidden="true">✉</span>
        <h2 class="mt-4 font-display text-3xl">Correo</h2>
        <p class="mt-3 text-neutral-600">Respondemos consultas generales y comerciales.</p>
        <a class="mt-3 inline-block font-extrabold text-red-700" href="mailto:info@dulcesar.com">
          info@dulcesar.com
        </a>
      </article>
    </div>
  </section>

  <section class="section bg-white">
    <div class="container-site grid gap-10 lg:grid-cols-[.9fr_1.1fr]">
      <div class="reveal">
        <span class="font-extrabold uppercase tracking-[.18em] text-red-700">Escribinos</span>
        <h2 class="section-title mt-3">¿En qué podemos ayudarte?</h2>
        <p class="mt-5 text-lg text-neutral-600">
          Completá el formulario y se abrirá tu aplicación de correo con el mensaje listo para
          enviar. No almacenamos tus datos en este sitio.
        </p>
        <div class="mt-8 rounded-2xl bg-red-50 p-6">
          <h3 class="font-black text-red-900">Consultas comerciales</h3>
          <p class="mt-2 text-sm text-neutral-600">
            Si querés distribuir nuestros productos, también podés conocer nuestro programa para
            distribuidores.
          </p>
          <a class="mt-4 inline-flex font-extrabold text-red-700" href="/distribuidores">
            Información para distribuidores →
          </a>
        </div>
      </div>

      <form id="contact-form" class="card reveal grid gap-5 p-6 sm:p-8">
        <div class="grid gap-5 sm:grid-cols-2">
          <label class="grid gap-2 font-bold">
            Nombre
            <input
              required
              name="nombre"
              autocomplete="name"
              class="rounded-xl border border-neutral-200 px-4 py-3 font-normal focus:border-red-500"
              placeholder="Tu nombre"
            />
          </label>
          <label class="grid gap-2 font-bold">
            Correo
            <input
              required
              type="email"
              name="correo"
              autocomplete="email"
              class="rounded-xl border border-neutral-200 px-4 py-3 font-normal focus:border-red-500"
              placeholder="nombre@correo.com"
            />
          </label>
        </div>
        <label class="grid gap-2 font-bold">
          Motivo
          <select name="motivo" class="rounded-xl border border-neutral-200 px-4 py-3 font-normal focus:border-red-500">
            <option>Consulta sobre productos</option>
            <option>Consulta comercial</option>
            <option>Atención al cliente</option>
            <option>Otra consulta</option>
          </select>
        </label>
        <label class="grid gap-2 font-bold">
          Mensaje
          <textarea
            required
            name="mensaje"
            rows="6"
            class="resize-y rounded-xl border border-neutral-200 px-4 py-3 font-normal focus:border-red-500"
            placeholder="Escribí tu consulta"
          ></textarea>
        </label>
        <button class="btn btn-primary w-fit" type="submit">Preparar correo</button>
      </form>
    </div>
  </section>

  <section class="bg-red-800 py-8">
    <div class="container-site">
      <iframe
        title="Ubicación de Dul-Cesar en Google Maps"
        src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3605.4247538301897!2d-57.525793925651655!3d-25.35707723000846!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x945dae851a06563d%3A0x46de4aeebb30b2ce!2sProductos%20Dul-Cesar!5e0!3m2!1ses!2spy!4v1750490688084!5m2!1ses!2spy"
        width="100%"
        height="460"
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
        class="rounded-[2rem] bg-white shadow-2xl"
      ></iframe>
    </div>
  </section>

  <script>
    document.querySelector<HTMLFormElement>('#contact-form')?.addEventListener('submit', (event) => {
      event.preventDefault();
      const form = new FormData(event.currentTarget as HTMLFormElement);
      const subject = `[Web] ${form.get('motivo')}`;
      const body = `Nombre: ${form.get('nombre')}\nCorreo: ${form.get('correo')}\n\n${form.get('mensaje')}`;
      window.location.href = `mailto:info@dulcesar.com?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
    });
  </script>
</BaseLayout>
