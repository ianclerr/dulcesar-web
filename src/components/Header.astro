---
const links = [
  { href: '/', label: 'Inicio' },
  { href: '/nosotros', label: 'Nosotros' },
  { href: '/#productos', label: 'Productos' },
  { href: '/recetario', label: 'Recetario' },
  { href: '/distribuidores', label: 'Distribuidores' },
  { href: '/contacto', label: 'Contacto' },
];

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<header class="sticky top-0 z-50 border-b border-red-100 bg-white/95 shadow-sm backdrop-blur-lg">
  <div class="container-site flex h-[var(--header-height)] items-center justify-between gap-6">
    <a href="/" aria-label="Dul-Cesar, ir al inicio" class="shrink-0">
      <img
        src="/images/logos/logo-rojo.webp"
        alt="Dul-Cesar"
        width="145"
        height="58"
        class="h-12 w-auto object-contain"
      />
    </a>

    <nav aria-label="Navegación principal" class="hidden items-center gap-1 lg:flex">
      {
        links.map((link) => {
          const active =
            link.href !== '/#productos' &&
            (currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href)));
          return (
            <a
              href={link.href}
              aria-current={active ? 'page' : undefined}
              class:list={[
                'rounded-full px-3.5 py-2 text-sm font-extrabold transition-colors',
                active
                  ? 'bg-red-50 text-red-700'
                  : 'text-neutral-700 hover:bg-orange-50 hover:text-red-700',
              ]}
            >
              {link.label}
            </a>
          );
        })
      }
    </nav>

    <button
      id="menu-button"
      type="button"
      aria-label="Abrir menú"
      aria-controls="mobile-menu"
      aria-expanded="false"
      class="grid h-11 w-11 place-items-center rounded-full bg-red-50 text-red-700 lg:hidden"
    >
      <svg viewBox="0 0 24 24" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" d="M4 7h16M4 12h16M4 17h16"></path>
      </svg>
    </button>
  </div>

  <div id="mobile-menu" class="fixed inset-0 top-[var(--header-height)] hidden bg-black/45 lg:hidden">
    <nav
      aria-label="Navegación móvil"
      class="ml-auto flex h-full w-[min(88vw,24rem)] flex-col gap-2 bg-white p-6 shadow-2xl"
    >
      {
        links.map((link) => (
          <a
            href={link.href}
            class="rounded-xl px-4 py-3 text-lg font-extrabold text-neutral-800 hover:bg-red-50 hover:text-red-700"
          >
            {link.label}
          </a>
        ))
      }
      <p class="mt-auto border-t border-red-100 pt-5 text-sm text-neutral-500">
        Sabores con tradición paraguaya desde 1982.
      </p>
    </nav>
  </div>
</header>

<script>
  const button = document.querySelector<HTMLButtonElement>('#menu-button');
  const menu = document.querySelector<HTMLElement>('#mobile-menu');

  const closeMenu = () => {
    menu?.classList.add('hidden');
    document.body.classList.remove('menu-open');
    button?.setAttribute('aria-expanded', 'false');
    button?.setAttribute('aria-label', 'Abrir menú');
  };

  button?.addEventListener('click', () => {
    const opens = menu?.classList.contains('hidden');
    menu?.classList.toggle('hidden');
    document.body.classList.toggle('menu-open', opens);
    button.setAttribute('aria-expanded', String(opens));
    button.setAttribute('aria-label', opens ? 'Cerrar menú' : 'Abrir menú');
  });

  menu?.addEventListener('click', (event) => {
    if (event.target === menu || (event.target as Element).closest('a')) closeMenu();
  });
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') closeMenu();
  });
</script>
